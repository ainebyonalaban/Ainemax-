        allow get: if isValidId(streamId) && isValidId(commentId);
        allow list: if isValidId(streamId) && existing().streamId == streamId;
        allow create: if isVerifiedIdentity() && isValidId(streamId) && isValidId(commentId) && isValidLiveComment(incoming(), commentId, streamId) && incoming().authorId == request.auth.uid && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin() && isValidId(streamId) && isValidId(commentId);
      }
    }

    // 22. Admin Announcements, Ads, Platform Settings & Immutable Audit Logs
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn() && existing().title is string;
      allow create: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming(), announcementId) && incoming().authorId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    match /ads/{adId} {
      allow get: if isValidId(adId) && (existing().active == true || isAdmin());
      allow list: if isBootstrappedAdmin() || existing().active == true;
      allow create: if isAdmin() && isValidId(adId) && isValidAdvertisement(incoming(), adId) && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(adId) && isValidAdvertisement(incoming(), adId) && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'sponsorName', 'description', 'targetUrl', 'active', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(adId);
    }

    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isBootstrappedAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidPlatformSetting(incoming(), settingId) && incoming().updatedBy == request.auth.uid && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /adminLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAdminLog(incoming(), logId) && incoming().adminId == request.auth.uid && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 23. Chunked Media Assets (Persistent Fallback for Photos & Short Videos)
    match /mediaAssets/{assetId} {
      allow get: if isValidId(assetId);
      allow list: if false;
      allow create: if isVerifiedIdentity() &&
        isValidId(assetId) &&
        isValidMediaAsset(incoming(), assetId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(assetId) && (isAdmin() || (isVerifiedIdentity() && isOwner(existing().ownerId)));

      match /chunks/{chunkId} {
        allow get: if isValidId(assetId) && isValidId(chunkId);
        allow list: if false;
        allow create: if isVerifiedIdentity() &&
          isValidId(assetId) &&
          isValidId(chunkId) &&
          isValidMediaChunk(incoming(), chunkId, assetId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/mediaAssets/$(assetId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(assetId) && isValidId(chunkId) && (isAdmin() || (isVerifiedIdentity() && get(/databases/$(database)/documents/mediaAssets/$(assetId)).data.ownerId == request.auth.uid));
      }
    }
  }
}
